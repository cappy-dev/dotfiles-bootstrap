# ~/.bashrc.custom - sourced by .bashrc hook from dotfiles-bootstrap
# Put your custom aliases and functions here

# ── Aliases ──────────────────────────────────────────────────────────
alias ll='eza -lah --icons --git 2>/dev/null || ls -lah'
alias la='eza -a --icons 2>/dev/null || ls -A'
alias lt='eza -T --icons 2>/dev/null || ls -R'
alias cat='bat --paging=never 2>/dev/null || cat'
alias grep='rg --color=auto 2>/dev/null || grep --color=auto'
alias find='fd 2>/dev/null || find'
alias vi='nvim 2>/dev/null || vim'

# ── History ──────────────────────────────────────────────────────────
HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoredups:erasedups
shopt -s histappend

# ── Prompt ───────────────────────────────────────────────────────────
if [[ -f /usr/share/fzf/key-bindings.bash ]]; then
    source /usr/share/fzf/key-bindings.bash
    source /usr/share/fzf/completion.bash
fi

# ── Functions ────────────────────────────────────────────────────────
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Quick project jump
proj() {
    local dir
    dir="$(find ~/Projects -maxdepth 2 -type d 2>/dev/null | fzf --height 40%)"
    [[ -n "$dir" ]] && cd "$dir"
}
